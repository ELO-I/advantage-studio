{
  "name": "advantage-studio",
  "private": true,
  "version": "1.0.0",
  "description": "A visual SmartSet configurator for the Kinesis Advantage2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write src resources tests *.json *.ts *.md .github",
    "check": "npm run lint && npm test && npm run build",
    "tauri": "tauri",
    "desktop": "node scripts/run-native.js tauri dev",
    "build:desktop": "node scripts/run-native.js tauri build",
    "test:rust": "node scripts/run-native.js cargo test",
    "screenshots": "node scripts/screenshots.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^17.13.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
